# Runtime identity and safety
APP_ENVIRONMENT=staging
NODE_ENV=production
APP_URL=https://your-staging-service.up.railway.app
# Start with Telnyx only. Add voice/ghl/woocommerce/shipstation/automations only
# after that integration's staging variables and webhook route are configured.
ENABLED_INTEGRATIONS=telnyx
# Mandatory provider-boundary lock. Comma-separated E.164 test numbers only.
STAGING_ALLOWED_RECIPIENTS=+15555550100
CORS_ALLOWED_ORIGINS=
PORT=3000

# Telnyx — the public key is found under Mission Control > Keys & Credentials.
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PHONE_NUMBER=
TELNYX_PUBLIC_KEY=
TELNYX_VOICE_CONNECTION_ID=
TELNYX_IOS_SIP_USERNAME=
TELNYX_IOS_SIP_PASSWORD=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=

# GoHighLevel
GHL_AGENCY_TOKEN=   # PIT token — needs contacts.readonly + conversations.readonly scopes
GHL_COMPANY_ID=
GHL_LOCATION_ID=
# Static bearer used only by the custom workflow bridge. Never put it in a URL/body.
GHL_BRIDGE_SECRET=

# WooCommerce webhook HMAC secret
WC_WEBHOOK_SECRET=

# ShipStation is disabled by default in staging.
SS_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Enforced in code on every request: only these reviewed models/providers may run.
OPENROUTER_ALLOWED_MODELS=anthropic/claude-haiku-4.5
OPENROUTER_ALLOWED_PROVIDERS=amazon-bedrock,google-vertex

# Private call recordings
CALL_RECORDING_RETENTION_DAYS=30
CALL_RECORDING_SIGNED_URL_SECONDS=60
# Destructive retention remains off until the owner approves the first dry run.
CALL_RECORDING_RETENTION_ENFORCED=false

# Auth
INBOX_PASSWORD=
# At least 32 random characters. No fallback is accepted.
SESSION_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Native APNs/PushKit delivery (staging bundle has separate tokens/credentials)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8_BASE64=
APNS_BUNDLE_ID=com.vicipeptides.inbox.staging
